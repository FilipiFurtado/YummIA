
# =====================================
# YummIA - Git Ignore
# =====================================

# Dependências Node.js
node_modules/
.pnpm-store/

# Builds e arquivos gerados
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variáveis de ambiente e credenciais
.env
.env.*
!.env.example
!.env.*.example

# Arquivos de chaves e certificados privados
*.pem
*.key
*.p12
*.pfx

# Next.js
.vercel/

# Prisma Client gerado
backend/src/generated/prisma/

# Bancos SQLite locais, caso utilizados
*.db
*.db-journal
*.sqlite
*.sqlite3

# Volumes locais do PostgreSQL
postgres_data/
pgdata/

# Testes e cobertura
coverage/
.nyc_output/
test-results/
playwright-report/

# Arquivos temporários
tmp/
temp/
*.tmp
*.bak

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# IDEs e editores
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Arquivos Python gerados, caso existam
__pycache__/
*.pyc
.venv/
venv/
